{
  "版本": 1,
  "说明": "配置端字段表：前端按此渲染，加配置项只改本表 + src/kernel.js 的清单命令",
  "分组": [
    {
      "名": "人设",
      "键前缀": "persona",
      "字段": [
        {
          "键": "persona.globalText",
          "标签": "全局人设（直接写整段）",
          "类型": "text",
          "默认": "",
          "说明": "留空 = 用下面这些字段自动拼装；填了就整段覆盖。这一段进系统提示词（personaPrefix），能吃满前缀缓存"
        },
        {
          "键": "persona.botName",
          "标签": "小助手名",
          "类型": "string",
          "默认": "小肥鱼",
          "回写": true
        },
        {
          "键": "persona.nicknames",
          "标签": "群友对她的叫法（逗号分隔）",
          "类型": "string",
          "默认": "肥鱼,鲸鲸,鲸鱼,大肥鱼",
          "说明": "除了全名，这些叫法也算在点名她。匹配到就当成「有人在跟她说话/拿她开玩笑」，不再当成路人闲聊。留空则只用全名和自动变体"
        },
        {
          "键": "persona.age",
          "标签": "身份/年龄段",
          "类型": "string",
          "默认": "二十来岁"
        },
        {
          "键": "persona.traits",
          "标签": "性格关键词",
          "类型": "string[]",
          "默认": [
            "嘴贫但有分寸",
            "对熟的人话多",
            "被问到就认真"
          ],
          "最大": 3
        },
        {
          "键": "persona.interests",
          "标签": "感兴趣的话题",
          "类型": "string[]",
          "默认": []
        },
        {
          "键": "persona.dislikes",
          "标签": "不想碰的话题",
          "类型": "string[]",
          "默认": []
        },
        {
          "键": "persona.tone",
          "标签": "全局语气",
          "类型": "enum",
          "取值": [
            "精炼",
            "详细"
          ],
          "默认": "精炼"
        },
        {
          "键": "persona.overflow",
          "标签": "超字数处理",
          "类型": "enum",
          "取值": [
            "压缩成一条",
            "拆两条"
          ],
          "默认": "压缩成一条"
        },
        {
          "键": "persona.memeFreq",
          "标签": "表情包频率",
          "类型": "enum",
          "取值": [
            "关",
            "少",
            "中"
          ],
          "默认": "少"
        },
        {
          "键": "persona.ageStage",
          "标签": "当前形态（按年龄切换）",
          "类型": "enum",
          "取值": [
            "幼年",
            "成年"
          ],
          "默认": "成年",
          "说明": "决定人设里的形体描述，也决定 [立绘] 发哪一张"
        },
        {
          "键": "persona.creator",
          "标签": "制作者的 ID / QQ",
          "类型": "string",
          "默认": "",
          "说明": "填了之后人设里会写：这个 ID 做了你。群里认这个 ID（或 QQ 号）的人就是制作者，怎么称呼由她自己决定。留空就不提"
        },
        {
          "键": "persona.illustrationYoung",
          "标签": "幼年立绘路径",
          "类型": "string",
          "默认": "角色形象图/幼年.jpg"
        },
        {
          "键": "persona.illustrationAdult",
          "标签": "成年立绘路径",
          "类型": "string",
          "默认": "角色形象图/成年.jpg"
        }
      ]
    },
    {
      "名": "判定",
      "键前缀": "gates",
      "字段": [
        {
          "键": "gates.depthChars",
          "标签": "三档字数上限",
          "类型": "int[3]",
          "默认": [
            30,
            100,
            250
          ],
          "说明": "三档字数上限 [短评/总结/详细]；判定流水与大脑提示词共用。30/100/250 是实测「能把一句话说完」的下限"
        },
        {
          "键": "gates.utilitySpeakAt",
          "标签": "话用值下限（低于它只配短句）",
          "类型": "number",
          "默认": 0.15,
          "范围": [
            0.05,
            0.55
          ]
        },
        {
          "键": "gates.utilityTerseAt",
          "标签": "常规线（到它就进大脑）",
          "类型": "number",
          "默认": 0.2,
          "范围": [
            0.1,
            0.75
          ],
          "说明": "U 低于这条线就走本地短句、不调大脑。注意 U 里含成本惩罚（问得越详细越负），所以被点名 / 要求展开 / 问句另有地板：至少中档、必进大脑；这条线只管普通闲聊"
        },
        {
          "键": "gates.utilityDetailedAt",
          "标签": "多讲线",
          "类型": "number",
          "默认": 0.65,
          "范围": [
            0.2,
            0.95
          ]
        },
        {
          "键": "gates.utilityLambda",
          "标签": "成本权重 λ",
          "类型": "number",
          "默认": 0.5,
          "范围": [
            0,
            2
          ]
        },
        {
          "键": "gates.greyLo",
          "标签": "灰区下界",
          "类型": "number",
          "默认": 0.4,
          "自适应": true,
          "说明": "开口线：低于它直接不理。调低 = 话更多也更贵；调高 = 更安静"
        },
        {
          "键": "gates.greyHi",
          "标签": "灰区上界",
          "类型": "number",
          "默认": 0.75,
          "自适应": true
        },
        {
          "键": "gates.weights",
          "标签": "六因子权重 w1..w4（判定真的会读）",
          "类型": "number[4]",
          "默认": [
            0.4,
            0.2,
            0.25,
            0.15
          ]
        },
        {
          "键": "gates.rescueAsk",
          "标签": "没点名的真问题",
          "类型": "enum",
          "取值": [
            "关",
            "短句",
            "中档"
          ],
          "默认": "中档",
          "说明": "本地判否、但看着是个真问题（问句/求详/有话题深度）且不是在跟别人说话时：抬成灰区。中档 = 并给中档地板走大脑；短句 = 只给一句短的；关 = 严格只看开口概率"
        },
        {
          "键": "gates.blockInjected",
          "标签": "疑似注入指令直接不回",
          "类型": "bool",
          "默认": true,
          "说明": "消息里出现「忽略以上内容」「你现在是」这类注入话术：开 = 直接不回、也不送大脑；关 = 只把开口概率减半（仍可能回）"
        },
        {
          "键": "admin.whitelist",
          "标签": "管理员白名单",
          "类型": "string[]",
          "默认": [],
          "说明": "N10：白名单里的 QQ 号可以发 /停 /开 /状态"
        }
      ]
    },
    {
      "名": "主动与节流",
      "键前缀": "autojoin",
      "字段": [
        {
          "键": "autojoin.rate",
          "标签": "主动参与意愿",
          "类型": "number",
          "默认": 0.25,
          "范围": [
            0.15,
            0.6
          ]
        },
        {
          "键": "autojoin.requireInterest",
          "标签": "只在命中兴趣时才主动搭话",
          "类型": "bool",
          "默认": false,
          "说明": "关（默认）＝她想接什么话题自己判断，频率仍由上面的每小时概率/冷却/配额管；开＝只在命中她兴趣词的话题上主动插话"
        },
        {
          "键": "autojoin.minGapSec",
          "标签": "最小间隔(秒)",
          "类型": "int",
          "默认": 120,
          "范围": [
            5,
            600
          ]
        }
      ]
    },
    {
      "名": "QQ 接入",
      "键前缀": "napcat",
      "字段": [
        {
          "键": "napcat.launchPath",
          "标签": "NapCat 启动程序路径",
          "类型": "string",
          "默认": "",
          "说明": "留空 = 启动器自己在常见位置找 NapCatWinBootMain.exe"
        },
        {
          "键": "napcat.uin",
          "标签": "小助手的 QQ 号（用于 NapCat 快速登录）",
          "类型": "string",
          "默认": "",
          "说明": "填了就按「NapCatWinBootMain.exe <QQ号>」启动 NapCat = 快速登录，不用每次去控制台点「选择登录」。前提是这台机器上已经手动登录过一次（NapCat 需要先登录一次才能记住会话）"
        },
        {
          "键": "napcat.configPath",
          "标签": "NapCat 配置文件路径",
          "类型": "string",
          "默认": "",
          "说明": "留空 = 自动在 NapCat 目录里找 config/onebot11_*.json；找到后会自动对齐地址与令牌"
        },
        {
          "键": "napcat.autoLaunch",
          "标签": "启动小助手时顺带拉起 NapCat",
          "类型": "bool",
          "默认": true,
          "说明": "启动器会等 OneBot 端口通了再拉起小助手，省得它一上来就连不上"
        },
        {
          "键": "napcat.autoClose",
          "标签": "退出小助手时顺带关闭 NapCat",
          "类型": "bool",
          "默认": true,
          "说明": "只关 NapCat 目录里的进程；你自己装的 QQ 不会被牵连"
        },
        {
          "键": "napcat.hideWindow",
          "标签": "把 NapCat 窗口藏在后台",
          "类型": "bool",
          "默认": true,
          "说明": "启动时不给它开控制台，并持续把它的窗口收起来"
        },
        {
          "键": "napcat.wsUrl",
          "标签": "OneBot WS 地址",
          "类型": "string",
          "默认": "ws://127.0.0.1:3001",
          "说明": "还是默认值时会按 NapCat 配置里的 WebSocket 服务端自动填"
        },
        {
          "键": "napcat.token",
          "标签": "访问令牌",
          "类型": "secret",
          "默认": "",
          "说明": "机密，只存本机；会用 NapCat 配置里的令牌自动对齐（留空 = 不改）"
        }
      ]
    },
    {
      "名": "群档案",
      "键前缀": "profile",
      "说明": "每个群单独学出来的画像与话题词条（含临时话题的过期与固化）",
      "字段": [
        {
          "键": "profile.interestStableHits",
          "标签": "话题固化：累计命中次数",
          "类型": "int",
          "默认": 4,
          "说明": "一个话题词累计被聊到这么多次（且跨够天数）才算稳定，之后写进群档案长期保留"
        },
        {
          "键": "profile.interestStableDays",
          "标签": "话题固化：跨几天",
          "类型": "int",
          "默认": 2,
          "说明": "稳定话题还要在至少这么多天里出现过，避免一次群里刷屏就固化"
        },
        {
          "键": "profile.interestWatchDays",
          "标签": "临时话题保留天数",
          "类型": "int",
          "默认": 3,
          "说明": "没固化的词进「观察区」，这么多天没再被聊到就自动清掉"
        },
        {
          "键": "profile.interestStableKeepDays",
          "标签": "固化话题沉寂降级天数",
          "类型": "int",
          "默认": 21,
          "说明": "固化的话题这么久没再被聊到就先降级回观察区（不直接删，避免误伤回潮话题）"
        },
        {
          "键": "profile.interestMax",
          "标签": "群档案常聊话题上限",
          "类型": "int",
          "默认": 8,
          "说明": "写进提示词的常聊话题最多几条（按命中次数排，稳定的在前）"
        },
        {
          "键": "runtime.memory.enabled",
          "标签": "让她自己记东西",
          "类型": "bool",
          "默认": true,
          "说明": "开＝每 N 条发言后，她自己总结一次想记住的事（谁是谁、发生过什么、对谁的看法），写进这个群的档案；下次聊天会带上"
        },
        {
          "键": "runtime.memory.everyN",
          "标签": "多少条发言总结一次",
          "类型": "number",
          "默认": 30,
          "说明": "默认 30。太小会频繁总结（费 token、记一堆废话），太大又容易忘事"
        },
        {
          "键": "runtime.autoTrainAt",
          "标签": "自动训练：标够多少条练一轮",
          "类型": "number",
          "默认": 30,
          "说明": "标注页每标够这么多条，就自动用全部标注训练一轮（0 = 不自动）。训练只更新开口模型的权重与阈值，不改别的东西"
        }
      ]
    },
    {
      "名": "运行时",
      "键前缀": "runtime",
      "字段": [
        {
          "键": "runtime.stageMode",
          "标签": "开口阶段",
          "类型": "enum",
          "取值": [
            "auto",
            "observe",
            "live"
          ],
          "默认": "auto",
          "说明": "auto=新群先观察→半自动→全自动（N9）"
        },
        {
          "键": "runtime.observeUntilMessages",
          "标签": "新群观察条数",
          "类型": "int",
          "默认": 80,
          "范围": [
            20,
            500
          ],
          "说明": "N9：攒满这么多条就转半自动"
        },
        {
          "键": "runtime.semiAutoDays",
          "标签": "半自动天数",
          "类型": "int",
          "默认": 3,
          "范围": [
            0,
            30
          ],
          "说明": "N9：半自动跑满这么多天转全自动"
        },
        {
          "键": "runtime.contextWindow",
          "标签": "上下文窗口(条)",
          "类型": "int",
          "默认": 20,
          "范围": [
            0,
            30
          ],
          "说明": "N8：进 prompt 且排在最后的群消息条数（20 约等于两屏对话；加大会多花未缓存的输入 token）"
        },
        {
          "键": "runtime.coalesceWindowMs",
          "标签": "连发合并窗口(毫秒)",
          "类型": "int",
          "默认": 6000,
          "范围": [
            1000,
            20000
          ],
          "说明": "N23：同一人连发多久算一轮"
        },
        {
          "键": "runtime.coalesceMaxBatch",
          "标签": "合并窗口最多几条",
          "类型": "int",
          "默认": 5,
          "范围": [
            1,
            20
          ],
          "说明": "同一个人在窗口期内连发多条时，最多合并成一轮交给大脑（默认 5）。条数越多越省调用，但越容易答偏。代码读它、调整页也引用它 —— 之前字段表漏了这项，界面上根本配不到"
        },
        {
          "键": "runtime.maxSegments",
          "标签": "最多分几条",
          "类型": "int",
          "默认": 3,
          "范围": [
            1,
            6
          ],
          "说明": "N6：超长回复最多拆成几条"
        },
        {
          "键": "runtime.budget.dailyTokens",
          "标签": "日预算(token)",
          "类型": "int",
          "默认": 5000000,
          "说明": "N23：超 80% 关主动，超 100% 只回被点名的"
        },
        {
          "键": "runtime.budget.groupHourlyLimit",
          "标签": "每群每小时上限(0=不限)",
          "类型": "int",
          "默认": 0,
          "说明": "0 = 不限（默认）。>0 时每群每小时最多发这么多条，超出静默丢弃（含主动搭话）"
        },
        {
          "键": "runtime.quoteReply",
          "标签": "引用回复",
          "类型": "enum",
          "取值": [
            "关",
            "自动",
            "仅标记"
          ],
          "默认": "自动",
          "说明": "按「她的发言是不是在指向别人的某条具体消息」判断，跟长短无关，也**不看别人有没有 @ 她**（@ 她 = 直接答，不引用）：她主动写 [引用]、或对方用引用发来（她在接那条线）→ 做成引用回复；自己陈述、闲聊接话、跟大家讨论 → 直接发言不引用。关 = 从不引用；仅标记 = 只听模型的"
        },
        {
          "键": "runtime.poke",
          "标签": "被戳一戳",
          "类型": "enum",
          "取值": [
            "关",
            "短答"
          ],
          "默认": "短答",
          "说明": "被戳时回一句本地短话（不走模型，零成本）；同一个人限流，见下两项"
        },
        {
          "键": "runtime.pokeBackRate",
          "标签": "回戳概率",
          "类型": "number",
          "默认": 0.35,
          "说明": "0~1：被戳时有多大比例戳回去（动作失败就退化成一句短话）"
        },
        {
          "键": "runtime.pokeGapSec",
          "标签": "戳一戳限流",
          "类型": "int",
          "默认": 60,
          "说明": "同一个人两次反应之间至少间隔多少秒，防止和人对戳刷屏"
        },
        {
          "键": "runtime.uiMessageLimit",
          "标签": "配置端消息保留条数",
          "类型": "int",
          "默认": 30,
          "说明": "状态页「收到的消息」每群保留多少条（落盘，重启还在）。满了按时间丢最老的；卡片本身可折叠"
        },
        {
          "键": "runtime.napcatWebui",
          "标签": "NapCat 配置页地址",
          "类型": "string",
          "默认": "http://127.0.0.1:6099",
          "说明": "配置端右上角的「NapCat 配置」按钮打开这个地址"
        },
        {
          "键": "runtime.webui.enabled",
          "标签": "启用配置端页面",
          "类型": "bool",
          "默认": true,
          "说明": "本地网页，只听 127.0.0.1，无登录（N25）"
        },
        {
          "键": "runtime.webui.port",
          "标签": "配置端端口",
          "类型": "int",
          "默认": 8799,
          "范围": [
            1024,
            65535
          ]
        }
      ]
    },
    {
      "名": "额外功能",
      "键前缀": "plugins",
      "说明": "社区插件形式的通道（免费模型 / 免费搜索）与表达层开关（表情包 / 立绘 / 图表）",
      "字段": [
        {
          "键": "plugins.archify",
          "标签": "允许画图表发出来",
          "类型": "bool",
          "默认": true,
          "说明": "开了之后，大脑可以用 archify 技能画流程图/架构图，程序把成品图发进群"
        },
        {
          "键": "plugins.archifyCleanup",
          "标签": "图表发完删掉本地文件",
          "类型": "bool",
          "默认": true,
          "说明": "群聊里不长期留图；关掉会把成品留在 .archify 目录里"
        },
        {
          "键": "plugins.illustration",
          "标签": "立绘（图片）",
